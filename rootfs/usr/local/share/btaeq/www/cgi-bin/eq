#!/bin/sh
# EQ control endpoint for the boombox UI, served by busybox httpd on 127.0.0.1:8088.
#
#   /cgi-bin/eq?get                               -> current state
#   /cgi-bin/eq?preset=NAME                       -> load a preset from $PRESETS/NAME
#   /cgi-bin/eq?on=1&pre=-3&hpf=45&g=0,1,2,...    -> set any of these (others unchanged)
#
# State is one line in $STATE; the filter list in $CONF is regenerated from it and
# swapped in with mv so libbtaeq.so always reads a complete file.

STATE=/var/local/btaeq.state
CONF=/var/local/btaeq.conf
PRESETS=/usr/local/share/btaeq/presets
BANDS="63 125 250 500 1000 2000 4000 8000 16000"
BAND_Q=1.4

echo "Content-Type: text/plain"
echo ""

# numbers like 3, -4.5, 12.0 only
is_num() {
	case "$1" in
	"" | *[!0-9.-]* | *-*-* | *.*.* | ?*-*) return 1 ;;
	esac
	return 0
}

clamp() { # value min max
	awk -v v="$1" -v lo="$2" -v hi="$3" 'BEGIN { if (v < lo) v = lo; if (v > hi) v = hi; print v + 0 }'
}

param() { # name -> value from QUERY_STRING
	echo "&$QUERY_STRING&" | sed -n "s/.*&$1=\([^&]*\)&.*/\1/p" | sed 's/%2[Cc]/,/g'
}

# defaults, then saved state
on=1 pre=0 hpf=40 preset=flat g="0,0,0,0,0,0,0,0,0"
[ -f "$STATE" ] && . "$STATE"

case "&$QUERY_STRING&" in
*"&get&"*)
	echo "on=$on pre=$pre hpf=$hpf preset=$preset g=$g"
	exit 0
	;;
esac

name=$(param preset)
if [ -n "$name" ]; then
	case "$name" in
	*[!a-z0-9_]*) echo "error=bad preset"; exit 0 ;;
	esac
	if [ ! -f "$PRESETS/$name" ]; then
		echo "error=no preset"
		exit 0
	fi
	. "$PRESETS/$name"
	preset=$name
fi

v=$(param on);  [ "$v" = 0 -o "$v" = 1 ] && on=$v
v=$(param pre); is_num "$v" && pre=$(clamp "$v" -12 6)
v=$(param hpf); is_num "$v" && hpf=$(clamp "$v" 20 150)
v=$(param g)
if [ -n "$v" ]; then
	new="" n=0
	for x in $(echo "$v" | tr ',' ' '); do
		is_num "$x" || { echo "error=bad gain"; exit 0; }
		new="$new${new:+,}$(clamp "$x" -12 12)"
		n=$((n + 1))
	done
	[ $n -eq 9 ] || { echo "error=need 9 gains"; exit 0; }
	g=$new
	[ -z "$name" ] && preset=custom
fi

tmp=$STATE.tmp.$$
echo "on=$on pre=$pre hpf=$hpf preset=$preset g=$g" > "$tmp" && mv "$tmp" "$STATE"

tmp=$CONF.tmp.$$
{
	echo "# generated by /cgi-bin/eq - edit presets or use the UI instead"
	echo "enabled $on"
	echo "preamp $pre"
	echo "limiter 1"
	echo "highpass $hpf 0.707"
	set -- $(echo "$g" | tr ',' ' ')
	for f in $BANDS; do
		echo "peak $f $BAND_Q $1"
		shift
	done
} > "$tmp" && mv "$tmp" "$CONF"

echo "on=$on pre=$pre hpf=$hpf preset=$preset g=$g"
